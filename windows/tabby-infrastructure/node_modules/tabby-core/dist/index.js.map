pug_html = pug_html + "\n\u003Cdiv class=\"container mt-3 mb-3\"\u003E\n  \u003Cdiv class=\"mb-3\"\u003E\n    \u003Cdiv class=\"tabby-logo\"\u003E\u003C\u002Fdiv\u003E\n    \u003Ch1 class=\"tabby-title\"\u003ETabby\u003Csup\u003Eα\u003C\u002Fsup\u003E\u003C\u002Fh1\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"text-center mb-3\" translate\u003EThank you for downloading Tabby!\u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-line\"\u003E\n    \u003Cdiv class=\"header\"\u003E\n      \u003Cdiv class=\"title\" translate\u003ELanguage\u003C\u002Fdiv\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cselect class=\"form-control\" [(ngModel)]=\"config.store.language\" (ngModelChange)=\"config.save()\"\u003E\n      \u003Coption [ngValue]=\"null\" translate\u003EAutomatic\u003C\u002Foption\u003E\n      \u003Coption [value]=\"lang.code\" *ngFor=\"let lang of allLanguages\"\u003E{{lang.name}}\u003C\u002Foption\u003E\n    \u003C\u002Fselect\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-line\"\u003E\n    \u003Cdiv class=\"header\"\u003E\n      \u003Cdiv class=\"title\" translate\u003ESwitch color scheme\u003C\u002Fdiv\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"btn-group\" role=\"group\"\u003E\n      \u003Cinput class=\"btn-check\" type=\"radio\" name=\"colorSchemeMode\" [(ngModel)]=\"config.store.appearance.colorSchemeMode\" (ngModelChange)=\"config.save()\" id=\"colorSchemeModeAuto\" [value]=\"&quot;auto&quot;\"\u003E\n      \u003Clabel class=\"btn btn-secondary\" for=\"colorSchemeModeAuto\"\u003E\u003Cspan translate\u003EFrom system\u003C\u002Fspan\u003E\u003C\u002Flabel\u003E\n      \u003Cinput class=\"btn-check\" type=\"radio\" name=\"colorSchemeMode\" [(ngModel)]=\"config.store.appearance.colorSchemeMode\" (ngModelChange)=\"config.save()\" id=\"colorSchemeModeDark\" [value]=\"&quot;dark&quot;\"\u003E\n      \u003Clabel class=\"btn btn-secondary\" for=\"colorSchemeModeDark\"\u003E\u003Cspan translate\u003EAlways dark\u003C\u002Fspan\u003E\u003C\u002Flabel\u003E\n      \u003Cinput class=\"btn-check\" type=\"radio\" name=\"colorSchemeMode\" [(ngModel)]=\"config.store.appearance.colorSchemeMode\" (ngModelChange)=\"config.save()\" id=\"colorSchemeModeLight\" [value]=\"&quot;light&quot;\"\u003E\n      \u003Clabel class=\"btn btn-secondary\" for=\"colorSchemeModeLight\"\u003E\u003Cspan translate\u003EAlways light\u003C\u002Fspan\u003E\u003C\u002Flabel\u003E\n    \u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-line\"\u003E\n    \u003Cdiv class=\"header\"\u003E\n      \u003Cdiv class=\"title\" translate\u003EEnable analytics\u003C\u002Fdiv\u003E\n      \u003Cdiv class=\"description\" translate\u003EHelp track the number of Tabby installs across the world!\u003C\u002Fdiv\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Ctoggle [(ngModel)]=\"config.store.enableAnalytics\"\u003E\u003C\u002Ftoggle\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-line\"\u003E\n    \u003Cdiv class=\"header\"\u003E\n      \u003Cdiv class=\"title\" translate\u003EEnable global hotkey (Ctrl-Space)\u003C\u002Fdiv\u003E\n      \u003Cdiv class=\"description\" translate\u003EToggles the Tabby window visibility\u003C\u002Fdiv\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Ctoggle [(ngModel)]=\"enableGlobalHotkey\"\u003E\u003C\u002Ftoggle\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"text-center mt-5\"\u003E\n    \u003Cbutton class=\"btn btn-primary\" (click)=\"closeAndDisable()\" translate\u003EClose and never show again\u003C\u002Fbutton\u003E\n  \u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E";;return pug_html;};
