illo"]},"You can change it later, but it's unrecoverable if forgotten.":{"msgid":"You can change it later, but it's unrecoverable if forgotten.","comments":{"reference":"locale/tmp-html/tabby-settings/src/components/setVaultPassphraseModal.component.html:4"},"msgstr":["Puedes cambiarlo más tarde, pero es irrecuperable si lo olvidas."]},"You could be under a man-in-the-middle attack right now, or the host key could have just been changed.":{"msgid":"You could be under a man-in-the-middle attack right now, or the host key could have just been changed.","comments":{"reference":"locale/tmp-html/tabby-ssh/src/components/hostKeyPromptModal.component.html:7"},"msgstr":["Podría estar bajo un ataque de intermediario en este momento, o la clave de host podría haber sido cambiada."]},"Zoom in":{"msgid":"Zoom in","comments":{"reference":"tabby-terminal/src/hotkeys.ts:54"},"msgstr":["Ampliar"]},"Zoom out":{"msgid":"Zoom out","comments":{"reference":"tabby-terminal/src/hotkeys.ts:58"},"msgstr":["Alejar vista"]}},"[Dynamic] port forwarding":{"id.port-forwarding.dynamic":{"msgid":"id.port-forwarding.dynamic","msgctxt":"[Dynamic] port forwarding","comments":{"reference":"locale/tmp-html/tabby-ssh/src/components/sshPortForwardingConfig.component.html:43\nlocale/tmp-html/tabby-ssh/src/components/sshPortForwardingConfig.component.html:5"},"msgstr":["id.port-forwarding.dynamic"]}}}}